# project registry holds local paths and project names — never publish (repo is public)
projects.json
__pycache__/
.venv/

# the author's script drafts live here for convenience — story prose carries
# character and world names and must never reach the public repo
*.docx
*.doc
*.odt
script_drafts/

# Word autosave/lock files. These are COPIES OF THE SCRIPT with a .tmp name,
# so *.docx alone does not protect them -- one was found staged for commit.
~WRL*.tmp
~$*
*.tmp
*.wbk
